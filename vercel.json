{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tts-backend-ezm3.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://tts-backend-ezm3.onrender.com/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
