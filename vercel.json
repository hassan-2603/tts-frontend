{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_BACKEND_URL/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://REPLACE_WITH_YOUR_BACKEND_URL/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
