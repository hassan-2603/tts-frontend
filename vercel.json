{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.arthnetra.in/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://api.arthnetra.in/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
