{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tts-backend-production-6975d66d.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://tts-backend-production-6975d66d.up.railway.app/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
