{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://device-lenses-beverages-real.trycloudflare.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://device-lenses-beverages-real.trycloudflare.com/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
